generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Reel {
  id             String   @id @default(cuid())
  title          String
  initialNote    String   @default("")
  status         String   @default("draft")
  selectedTakeId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  takes          Take[]
}

model Take {
  id             String   @id @default(cuid())
  reelId         String
  reel           Reel     @relation(fields: [reelId], references: [id], onDelete: Restrict)
  number         Int
  inputType      String
  authorNote     String   @default("")
  idempotencyKey String?
  mediaStatus    String   @default("ready")
  originalName   String?
  storedPath     String?
  mimeType       String?
  bodyText       String   @default("")
  createdAt      DateTime @default(now())
  jobs           Job[]

  @@unique([reelId, number])
  @@unique([reelId, idempotencyKey])
}

model Job {
  id           String   @id @default(cuid())
  originalName String
  videoPath    String
  audioPath    String?
  durationSec  Float?
  status       String   @default("queued")
  errorCode    String?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  takeId       String?
  take         Take?    @relation(fields: [takeId], references: [id], onDelete: Restrict)
  analysis     AnalysisResult?
}

model AnalysisResult {
  id           String   @id @default(cuid())
  jobId        String   @unique
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  overallScore Float
  summary      String
  payload      String
  createdAt    DateTime @default(now())
}

model Criterion {
  id             String  @id
  label          String
  description    String
  weight         Int
  enabled        Boolean
  sortOrder      Int
  isExtended     Boolean @default(false)
  categoryId     String  @default("content")
  categoryLabel  String  @default("")
  categoryWeight Int     @default(20)
  categoryOrder  Int     @default(0)
}
