DATABASE_URL=
DIRECT_URL=
TEST_DATABASE_URL=
VOCAL_CRITERIA_ADMIN_USER_IDS=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GROQ_API_KEY=
# xAI is off unless VOCAL_USE_XAI=1. Do not enable without an explicit ask.
# VOCAL_USE_XAI=0
# XAI_API_KEY=
# XAI_MODEL=grok-4
# VOCAL_AI_NO_RETRY=1
STT_MODEL=whisper-large-v3-turbo
LLM_MODEL=openai/gpt-oss-120b
MAX_VIDEO_SECONDS=180
MAX_UPLOAD_MB=80
# C00 policy. Default on. Set 0/off/false/disabled to roll back to V03 thought turns.
VOCAL_C00_POLICY=

# I07 AI/STT gateway. Limits are ON by default; set a limit to 0 only for local dev.
# Per owner, per day: chat tokens (prompt+completion) and audio seconds sent to STT.
# VOCAL_DAILY_TOKEN_LIMIT=200000
# VOCAL_DAILY_STT_SECONDS=3600
# Deadlines: whole chat operation / one provider attempt / whole STT operation / one STT attempt.
# VOCAL_AI_TIMEOUT_MS=90000
# VOCAL_AI_ATTEMPT_TIMEOUT_MS=45000
# VOCAL_STT_TIMEOUT_MS=300000
# VOCAL_STT_ATTEMPT_TIMEOUT_MS=120000
# Voice answers in dialogues: size (MB) and length (s) limits.
# VOCAL_MAX_VOICE_MB=15
# VOCAL_MAX_VOICE_SECONDS=180
# Test-only: shrinks the media job lease.
# VOCAL_JOB_LEASE_MS=120000
