# Vocal: environment variable NAMES only. Copy to .env and fill the values on the server; never commit .env.
# Values are not stored here. A comment after a name says what it is and, where the code fixes one, the default.

# --- Required: database and auth (Supabase project of Vocal) ---
DATABASE_URL=            # app connection (pooler or direct)
DIRECT_URL=              # direct connection: pg_dump, manual migrations (not the pooler)
NEXT_PUBLIC_SUPABASE_URL=              # baked in at build time: set before `docker compose build`
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=  # baked in at build time
SUPABASE_SERVICE_ROLE_KEY=             # server only: account deletion; without it account deletion answers 503

# --- Required: model and speech ---
GROQ_API_KEY=            # chat model and speech recognition

# --- Storage and process ---
VOCAL_STORAGE_ROOT=      # media root (Docker: /data)
NEXT_MANUAL_SIG_HANDLE=true   # production: graceful shutdown handled by the app
VOCAL_SHUTDOWN_GRACE_MS= # wait for active jobs on SIGTERM
VOCAL_AI_TIMEOUT_MS=     # model call deadline
VOCAL_STT_TIMEOUT_MS=    # speech recognition deadline

# --- Profile ---
VOCAL_FEEDBACK_URL=       # "Сообщить о проблеме" in the profile: mailto:… , https://… or an e-mail address; unset = the row is hidden

# --- Limits and protections (L1) ---
VOCAL_OWNER_USER_IDS=          # comma-separated auth user ids of the owner/developers: exempt from the protections
VOCAL_ABUSE_GUARDS=            # on: request rate, global cap, per-thought ceiling without the quota (off by default)
VOCAL_DAILY_TOKEN_LIMIT=       # chat tokens per user per day (default 200000, 0 = off)
VOCAL_DAILY_STT_SECONDS=       # speech seconds per user per day (default 3600, 0 = off)
VOCAL_GLOBAL_DAILY_TOKEN_CAP=  # all users per day, then 503 AI_PAUSED (default 20000000, 0 = off); set under the provider limit
VOCAL_RATE_PER_MINUTE=         # requests per user per minute (default 30)
VOCAL_THOUGHT_QUESTION_CEILING=  # questions per thought (default 8)
VOCAL_THOUGHT_TOKEN_CEILING=     # dialogue tokens per thought (default 40000)
VOCAL_PROVIDER_DAILY_TOKEN_LIMIT=  # report only: the provider's daily token limit (default 200000); enforces nothing
VOCAL_PROVIDER_TPM_LIMIT=      # report only: the provider's tokens per minute (default 8000)
VOCAL_PROVIDER_RPM_LIMIT=      # report only: the provider's requests per minute (default 30)
VOCAL_AI_RETRY_WAIT_MS=        # total wait budget for provider 429 retries of one call (default 60000)
VOCAL_REPORT_DIR=              # report only: where `npm run report:daily` writes (default ./reports)

# --- Do not set on the live server until the owner decides ---
# VOCAL_QUOTA                  # thought quota; needs migration 11_user_quota (prisma/pending), off by default
# VOCAL_V07_CRAFT              # cards flag, stays off

# --- Test and local only: never set on the server ---
# TEST_DATABASE_URL, VOCAL_UI_TEST_DB, VOCAL_AI_MOCK, VOCAL_STT_MOCK, VOCAL_SKIP_JOB_ENQUEUE, VOCAL_TEST_USER_ID,
# VOCAL_REQUIRE_SUPABASE_AUTH, VOCAL_ALLOW_NONLOCAL_TEST_DB
